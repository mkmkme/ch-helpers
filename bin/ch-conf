#!/bin/bash
set -euo pipefail
shopt -s nullglob

# Repo root = parent of this script's dir
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CFGROOT="$ROOT/config"
PARTS="$CFGROOT/parts"
CONFD="$CFGROOT/config.d"
CONFIG_XML="$CFGROOT/config.xml"
USERS_AVAIL="$CFGROOT/users-available"
USERS_D="$CFGROOT/users.d"
USERS_XML="$CFGROOT/users.xml"

usage() {
    echo "usage: ch-conf {list|enable|disable|show|edit} [name...]"
    echo "       ch-conf {user-list|user-enable|user-disable|user-show|user-edit} [name...]"
    exit "${1:-0}"
}

# Value substituted into *.xml.in parts when they are enabled
CONFIG_DIR="$CFGROOT"

# match_parts <available_dir> <name> -- print matching part paths, one per line
match_parts() {
    local avail="$1" arg="$2"
    arg="${arg%.in}"; arg="${arg%.xml}"
    local matches=("$avail"/*"$arg"*.xml "$avail"/*"$arg"*.xml.in)
    [[ ${#matches[@]} -gt 0 ]] || { echo "no match for '$arg'" >&2; return 1; }
    printf '%s\n' "${matches[@]}"
}

# expand_part <template> <destination>
expand_part() {
    local src="$1" dest="$2"
    local name; name=$(basename "$src")
    local content; content=$(<"$src")
    content="${content//@@CONFIG_DIR@@/$CONFIG_DIR}"
    if [[ "$content" =~ @@[A-Za-z_][A-Za-z0-9_]*@@ ]]; then
        echo "unknown variable ${BASH_REMATCH[0]} in $name" >&2
        exit 1
    fi
    printf '<!-- generated by ch-conf from %s, edit the template instead -->\n%s\n' "$name" "$content" > "$dest"
}

# toggle <list|enable|disable> <available_dir> <enabled_dir> [name...]
toggle() {
    local op="$1" avail="$2" enabled="$3"; shift 3
    local avail_name; avail_name=$(basename "$avail")
    mkdir -p "$enabled"
    case "$op" in
      list)
        for p in "$avail"/*.xml "$avail"/*.xml.in; do
            local name; name=$(basename "$p")
            local target="$enabled/${name%.in}"
            [[ -f "$target" || -L "$target" ]] && echo "  [x] $name" || echo "  [ ] $name"
        done | sort -k2
        ;;
      enable)
        for arg in "$@"; do
            local matches=(); mapfile -t matches < <(match_parts "$avail" "$arg") || true
            [[ ${#matches[@]} -gt 0 ]] || exit 1
            for p in "${matches[@]}"; do
                local name; name=$(basename "$p")
                if [[ "$name" == *.in ]]; then
                    expand_part "$p" "$enabled/${name%.in}"
                else
                    ln -sfn "../$avail_name/$name" "$enabled/$name"
                fi
                echo "enabled  $name"
            done
        done
        ;;
      disable)
        for arg in "$@"; do
            arg="${arg%.in}"; arg="${arg%.xml}"
            local found=0
            for l in "$enabled"/*"$arg"*.xml; do
                [[ -f "$l" || -L "$l" ]] || continue
                rm "$l"; echo "disabled $(basename "$l")"; found=1
            done
            [[ $found -eq 1 ]] || echo "no enabled match for '$arg'" >&2
        done
        ;;
    esac
}

# show <base_file> <available_dir> [name...]
show() {
    local base="$1" avail="$2"; shift 2
    [[ $# -gt 0 ]] || { cat "$base"; return; }
    for arg in "$@"; do
        local matches=(); mapfile -t matches < <(match_parts "$avail" "$arg") || true
        [[ ${#matches[@]} -gt 0 ]] || exit 1
        cat "${matches[@]}"
    done
}

# edit <base_file> <available_dir> [name...]
edit() {
    local base="$1" avail="$2"; shift 2
    [[ $# -gt 0 ]] || { "${EDITOR:-vi}" "$base"; return; }
    local files=()
    for arg in "$@"; do
        local matches=(); mapfile -t matches < <(match_parts "$avail" "$arg") || true
        [[ ${#matches[@]} -gt 0 ]] || exit 1
        files+=("${matches[@]}")
    done
    "${EDITOR:-vi}" "${files[@]}"
}

cmd="${1:-list}"; shift || true

case "$cmd" in
  list|enable|disable)                 toggle "$cmd"           "$PARTS"       "$CONFD"  "$@" ;;
  user-list|user-enable|user-disable)  toggle "${cmd#user-}"   "$USERS_AVAIL" "$USERS_D" "$@" ;;
  show)                                show "$CONFIG_XML" "$PARTS"       "$@" ;;
  user-show)                           show "$USERS_XML"  "$USERS_AVAIL" "$@" ;;
  edit)                                edit "$CONFIG_XML" "$PARTS"       "$@" ;;
  user-edit)                           edit "$USERS_XML"  "$USERS_AVAIL" "$@" ;;
  -h|--help)                           usage 0 ;;
  *)                                   usage 1 ;;
esac
