#!/bin/bash
set -euo pipefail

function is_pwd_a_git_repo() {
    git rev-parse --is-inside-work-tree 2>/dev/null >/dev/null
}

function help() {
    echo "Usage: ch-run [options]"
    echo "Options:"
    echo "  -b, --binary <path>    Path to the ClickHouse binary"
    echo "  -d, --datadir <path>   Persistent data directory (default: temporary)"
    echo "  --stop                 Stop the managed server"
    echo "  --status               Show the managed server's status"
    echo "  --logs                 Show the managed server's journal logs"
    echo "  --help                 Show this help message"
}

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG="$ROOT/config/config.xml"
UNIT="ch-run.service"

binary="${CH_BINARY:-}"
datadir=""
action=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -b|--binary)    [[ $# -ge 2 ]] || { echo "!! missing binary path" >&2; exit 1; }; binary="$2"; shift 2 ;;
    -d|--datadir)   [[ $# -ge 2 ]] || { echo "!! missing data directory" >&2; exit 1; }; datadir="$2"; shift 2 ;;
    --stop|--status|--logs)
        [[ -z $action ]] || { echo "!! choose only one of --stop, --status, --logs" >&2; exit 1; }
        action="${1#--}"; shift ;;
    --)             shift; break ;;
    --help)         help; exit 0 ;;
    *)              break ;;
  esac
done

if [[ -n $action ]]; then
    if [[ $# -gt 0 ]]; then
        echo "!! --$action does not accept server arguments" >&2
        exit 1
    fi
    case "$action" in
        stop|status) exec systemctl --user "$action" "$UNIT" ;;
        logs) exec journalctl --user -u "$UNIT" ;;
    esac
fi

if [[ -z "$binary" ]]; then
    if is_pwd_a_git_repo; then
        binary="$(git rev-parse --show-toplevel 2>/dev/null)/build/programs/clickhouse"
    else
        echo "!! ClickHouse binary not found, provide one with -b/--binary or run from a git repo" >&2
        exit 1
    fi
fi

if [[ ! -x "$binary" ]]; then
    echo "!! ClickHouse binary not executable: $binary" >&2
    exit 1
fi

binary="$(realpath -e -- "$binary")"

# ClickHouse must remain in the foreground so systemd can manage its lifetime.
for arg in "$@"; do
    if [[ $arg == --daemon || $arg == --daemon=* ]]; then
        echo "!! ClickHouse --daemon is incompatible with systemd management" >&2
        exit 1
    fi
done

temporary=0
properties=()
if [[ -z $datadir ]]; then
    datadir="$(mktemp -d /var/tmp/ch-run-XXXXXXXX)"
    temporary=1
    properties=(-p "ExecStopPost=/usr/bin/rm -rf -- $datadir")
else
    mkdir -p -- "$datadir"
    datadir="$(cd "$datadir" && pwd -P)"
fi
echo "data directory: $datadir" >&2

if systemd-run --user --unit="$UNIT" --service-type=exec --collect \
    --expand-environment=no -p TimeoutStopSec=60s "${properties[@]}" \
    --setenv="CLICKHOUSE_DATA_PATH=$datadir/" \
    "$binary" server --config-file="$CONFIG" "$@"; then
    echo "started $UNIT" >&2
else
    result=$?
    # A rejected start (e.g. an existing unit) never runs ExecStopPost.
    if [[ $temporary -eq 1 ]]; then
        rm -rf -- "$datadir"
    fi
    exit "$result"
fi
